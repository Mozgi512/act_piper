        <weld name="r_mocap_weld" body1="r_mocap" body2="r_weldpoint" solimp="0.99 0.999 0.001" solref="0.02 1"/>
        <!weld name="l_gripper_weld" body1="l_link6" body2="box" solref="0.01 1" solimp=".25 .25 0.001" />
