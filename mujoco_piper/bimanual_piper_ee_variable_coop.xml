<mujoco>
    <include file="ACTworkspace.xml"/>
    
    <asset>
        <mesh name="cube_large" file="work_cube.stl" scale="4 4 4"/>
        <mesh name="cube_small" file="work_cube.stl" scale="3.4 3.4 3.4"/>
    </asset>
 
    <equality>
        <!connect name="l_mocap_weld" site1="l_mocap_site1" site2="l_cam_focus" solref="0.01 1" solimp=".25 .25 0.001"/>
        <!connect name="r_mocap_weld" site1="r_mocap_site1" site2="r_cam_focus" solref="0.01 1" solimp=".25 .25 0.001"/>
        <weld name="l_mocap_weld" body1="l_mocap" body2="l_weldpoint" solimp="0.99 0.999 0.001" solref="0.02 1"/>
        <weld name="r_mocap_weld" body1="r_mocap" body2="r_weldpoint" solimp="0.99 0.999 0.001" solref="0.02 1"/>
        <joint joint1="belt_joint" joint2="belt_extension_joint" polycoef="0 1 0 0 0" />
       
    </equality>


    <worldbody>
        <body mocap="true" name="l_mocap" pos="-0.235 0 0.16" >
            <site pos="0 0 0" size="0.003 0.003 0.03" type="box" name="r_mocap_site1" rgba="1 0 0 1"/>
            <site pos="0 0 0" size="0.003 0.03 0.003" type="box" name="r_mocap_site2" rgba="1 0 0 1"/>
            <site pos="0 0 0" size="0.03 0.003 0.003" type="box" name="r_mocap_site3" rgba="1 0 0 1"/>
        </body>
        <body mocap="true" name="r_mocap" pos="0.235 0 0.16">
            <site pos="0 0 0" size="0.003 0.003 0.03" type="box" name="l_mocap_site1" rgba="1 0 0 1"/>
            <site pos="0 0 0" size="0.003 0.03 0.003" type="box" name="l_mocap_site2" rgba="1 0 0 1"/>
            <site pos="0 0 0" size="0.03 0.003 0.003" type="box" name="l_mocap_site3" rgba="1 0 0 1"/>
        </body>

        <!-- Invisible belt extension to the left (-1.0 -> -0.5 range approx) -->
        <body name="belt_extension" pos="-1.0 0.38 -0.02">
             <joint name="belt_extension_joint" type="slide" axis="1 0 0" frictionloss="0.0" />
             <geom condim="4" friction="0 0 0" pos="0 0 0" size="0.5 0.099 0.02" type="box" name="belt_extension_geom" rgba="0 1 0 0" />
        </body>

        <body name="cube_0" pos="0 0.0 0.05">
            <joint name="cube_0_joint" type="free" frictionloss="0.01" />
            <inertial pos="0 0 0" mass="0.02" diaginertia="0.002 0.002 0.002" />
            <geom condim="4" solimp="2 1 0.01" solref="0.01 1" friction="3 0.005 0.0001" pos="0 0 0" type="mesh" mesh="cube_large" name="cube_0" rgba="1 0 0 1" />
        </body>
        <body name="cube_1" pos="0 0.0 0.05">
            <joint name="cube_1_joint" type="free" frictionloss="0.01" />
            <inertial pos="0 0 0" mass="0.02" diaginertia="0.002 0.002 0.002" />
            <geom condim="4" solimp="2 1 0.01" solref="0.01 1" friction="3 0.005 0.0001" pos="0 0 0" type="mesh" mesh="cube_large" name="cube_1" rgba="0 1 0 1" />
        </body>
        <body name="cube_2" pos="0 0.0 0.05">
            <joint name="cube_2_joint" type="free" frictionloss="0.01" />
            <inertial pos="0 0 0" mass="0.02" diaginertia="0.002 0.002 0.002" />
            <geom condim="4" solimp="2 1 0.01" solref="0.01 1" friction="3 0.005 0.0001" pos="0 0 0" type="mesh" mesh="cube_large" name="cube_2" rgba="0 0 1 1" />
        </body>
        <body name="cube_3" pos="0 0.0 0.05">
            <joint name="cube_3_joint" type="free" frictionloss="0.01" />
            <inertial pos="0 0 0" mass="0.02" diaginertia="0.002 0.002 0.002" />
            <geom condim="4" solimp="2 1 0.01" solref="0.01 1" friction="3 0.005 0.0001" pos="0 0 0" type="mesh" mesh="cube_large" name="cube_3" rgba="1 1 0 1" />
        </body>
        <body name="cube_4" pos="0 0.0 0.05">
            <joint name="cube_4_joint" type="free" frictionloss="0.01" />
            <inertial pos="0 0 0" mass="0.02" diaginertia="0.002 0.002 0.002" />
            <geom condim="4" solimp="2 1 0.01" solref="0.01 1" friction="3 0.005 0.0001" pos="0 0 0" type="mesh" mesh="cube_large" name="cube_4" rgba="0 1 1 1" />
        </body>
        <body name="cube_5" pos="0 0.0 0.05">
            <joint name="cube_5_joint" type="free" frictionloss="0.01" />
            <inertial pos="0 0 0" mass="0.02" diaginertia="0.002 0.002 0.002" />
            <geom condim="4" solimp="2 1 0.01" solref="0.01 1" friction="3 0.005 0.0001" pos="0 0 0" type="mesh" mesh="cube_large" name="cube_5" rgba="1 0 1 1" />
        </body>
        <body name="cube_6" pos="0 0.0 0.05">
            <joint name="cube_6_joint" type="free" frictionloss="0.01" />
            <inertial pos="0 0 0" mass="0.02" diaginertia="0.002 0.002 0.002" />
            <geom condim="4" solimp="2 1 0.01" solref="0.01 1" friction="3 0.005 0.0001" pos="0 0 0" type="mesh" mesh="cube_large" name="cube_6" rgba="0.5 0.5 0.5 1" />
        </body>
        <body name="cube_7" pos="0 0.0 0.05">
            <joint name="cube_7_joint" type="free" frictionloss="0.01" />
            <inertial pos="0 0 0" mass="0.02" diaginertia="0.002 0.002 0.002" />
            <geom condim="4" solimp="2 1 0.01" solref="0.01 1" friction="3 0.005 0.0001" pos="0 0 0" type="mesh" mesh="cube_large" name="cube_7" rgba="1 0.5 0 1" />
        </body>
        <body name="cube_8" pos="0 0.0 0.05">
            <joint name="cube_8_joint" type="free" frictionloss="0.01" />
            <inertial pos="0 0 0" mass="0.02" diaginertia="0.002 0.002 0.002" />
            <geom condim="4" solimp="2 1 0.01" solref="0.01 1" friction="3 0.005 0.0001" pos="0 0 0" type="mesh" mesh="cube_large" name="cube_8" rgba="0 0.5 1 1" />
        </body>
        <body name="cube_9" pos="0 0.0 0.05">
            <joint name="cube_9_joint" type="free" frictionloss="0.01" />
            <inertial pos="0 0 0" mass="0.02" diaginertia="0.002 0.002 0.002" />
            <geom condim="4" solimp="2 1 0.01" solref="0.01 1" friction="3 0.005 0.0001" pos="0 0 0" type="mesh" mesh="cube_large" name="cube_9" rgba="0.5 0 1 1" />
        </body>

    </worldbody>

    <actuator>
        <position name="l_gripper" joint="l_joint7" class="finger" kp="800" kv="5"/>
        <position name="r_gripper" joint="r_joint7" class="finger" kp="800" kv="5"/>
    </actuator>

    <equality>
        <joint joint1="l_joint8" joint2="l_joint7" polycoef="0 -1 0 0 0"/>
        <joint joint1="r_joint8" joint2="r_joint7" polycoef="0 -1 0 0 0"/>
    </equality>

</mujoco>
